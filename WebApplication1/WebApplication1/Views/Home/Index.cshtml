@model IEnumerable<WebApplication1.Models.CourseRound>
@{
    ViewData["Title"] = "Home Page";
}
        <div class="content">
          <div class="page-head">
            <div>
              <div class="eyebrow">
                Academy overview
              </div>
              <h2 class="page-title">
                Welcome to Core Academy
              </h2>
              <p class="page-desc">
                A central place to manage courses, instructors, students, and course rounds.
              </p>
            </div>
            <a class="btn btn-primary" asp-controller="Course" asp-action="Create">
              ＋ Create course
            </a>
          </div>
          <div class="metrics">
            <div class="metric">
              <div class="metric-top">
                Total Students
                <span class="metric-icon">
                  ♧
                </span>
              </div>
              <div class="metric-value">
               @ViewBag.studentCount
              </div>
            </div>
            <div class="metric">
              <div class="metric-top">
                Active Courses
                <span class="metric-icon teal">
                  ▤
                </span>
              </div>
              <div class="metric-value">
                @ViewBag.courseCount
              </div>
             
            </div>
            <div class="metric">
              <div class="metric-top">
                Instructors
                <span class="metric-icon orange">
                  ♙
                </span>
              </div>
              <div class="metric-value">
                 @ViewBag.instructorCount
              </div>
             
            </div>
            <div class="metric">
              <div class="metric-top">
                Running Rounds
                <span class="metric-icon pink">
                  ▦
                </span>
              </div>
              <div class="metric-value">
                 @ViewBag.roundCount
              </div>
             
            </div>
          </div>
          <div class="grid-main">
            <section class="panel">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">
                    Popular Courses
                  </h3>
                  <div class="panel-sub">
                    A quick look at the academy catalog
                  </div>
                </div>
                <a class="text-link" asp-controller="Course" asp-action="Index">
                  View all courses →
                </a>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>
                        Course
                      </th>
                      <th>
                        Instructor
                      </th>
                       <th>
                        Student
                      </th>
                     
                    </tr>
                  </thead>
                  <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.course.name)
                        </td>
                       
                        <td>

                            @Html.DisplayFor(model => item.instructor.name)

                        </td>
                      
                        <td>

                            

                        </td>
                       
                    </tr>
                }
            </tbody>
                </table>
              </div>
            </section>
            <section class="panel">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">
                    Upcoming Rounds
                  </h3>
                  <div class="panel-sub">
                    Upcoming course batches
                  </div>
                </div>
                <a class="text-link" href="rounds.html">
                  View all →
                </a>
              </div>
              <div class="rounds">
                <div class="round">
                  <div class="date">
                    <strong>
                      24
                    </strong>
                    <span>
                      Oct
                    </span>
                  </div>
                  <div>
                    <div class="round-name">
                      C++ Fundamentals · R05
                    </div>
                    <div class="round-meta">
                      10:00 AM · Mina Hassan
                    </div>
                    <div style="margin-top:7px">
                      <span class="pill upcoming-pill">
                        Starts soon
                      </span>
                    </div>
                  </div>
                </div>
                <div class="round">
                  <div class="date" style="background:#e0f8f3;color:#0a928a;border-color:#d1f2ea">
                    <strong>
                      28
                    </strong>
                    <span>
                      Oct
                    </span>
                  </div>
                  <div>
                    <div class="round-name">
                      OOP Masterclass · R02
                    </div>
                    <div class="round-meta">
                      06:00 PM · Sara Adel
                    </div>
                    <div style="margin-top:7px">
                      <span class="pill active-pill">
                        Enrollment open
                      </span>
                    </div>
                  </div>
                </div>
                <div class="round">
                  <div class="date" style="background:#fff1de;color:#bd771d;border-color:#ffe8ca">
                    <strong>
                      02
                    </strong>
                    <span>
                      Nov
                    </span>
                  </div>
                  <div>
                    <div class="round-name">
                      Data Structures · R01
                    </div>
                    <div class="round-meta">
                      04:00 PM · Omar Nabil
                    </div>
                    <div style="margin-top:7px">
                      <span class="pill draft-pill">
                        Planning
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
          <div class="quick-grid">
            <a class="quick" asp-controller="Course" asp-action="Create">
              <span class="quick-icon">
                ＋
              </span>
              <div>
                <strong>
                  Create Course
                </strong>
                <span>
                  Add a learning program
                </span>
              </div>
            </a>
            <a class="quick"  asp-controller="Student" asp-action="Index">
              <span class="quick-icon" style="background:#def8f4;color:#109b96">
                ♧
              </span>
              <div>
                <strong>
                  Students
                </strong>
                <span>
                  View learner directory
                </span>
              </div>
            </a>
            <a class="quick" asp-controller="Instructor" asp-action="Index">
              <span class="quick-icon" style="background:#fff0dc;color:#bd771d">
                ♙
              </span>
              <div>
                <strong>
                  Instructors
                </strong>
                <span>
                  Manage teaching team
                </span>
              </div>
            </a>
            <a class="quick" asp-controller="CourseRound" asp-action="Index">
              <span class="quick-icon" style="background:#ffe7f0;color:#d95f91">
                ▦
              </span>
              <div>
                <strong>
                  Course Rounds
                </strong>
                <span>
                  Plan upcoming batches
                </span>
              </div>
            </a>
          </div>
          <div class="footer">
            © Core Academy · Static HTML prototype
          </div>
        </div>


