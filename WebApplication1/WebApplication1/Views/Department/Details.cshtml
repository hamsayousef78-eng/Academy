@model WebApplication1.Models.Department

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Department</h4>
    <hr />
    <dl class="row">
        <dd class="col-sm-10">
            <table class="table table-bordered ">
                <thead>
                    <tr>
                        <th>Department ID</th>
                        <th>Department Name</th>
                    </tr>
                </thead>

                <tbody>
                        <tr>
                            <td>@Model.id</td>
                        <td>@Model.name</td>
                        </tr>
                </tbody>
            </table>
        </dd>
        <dd class="col-sm-10">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Age</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var student in Model.students)
                    {
                        <tr>
                            <td>@student.id</td>
                            <td>@student.name</td>
                            <td>@student.age</td>
                        </tr>
                    }
                </tbody>
            </table>
        </dd>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
