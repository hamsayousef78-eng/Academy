@model WebApplication1.Models.Instructor

@{
    ViewData["Title"] = "Delete";
}

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">
                Student catalog / @Model.name
            </div>
            <h2 class="page-title">
                Delete instructor
            </h2>
           
        </div>
        <a asp-controller="Student" asp-action="Index" class="btn btn-light">
            ← Back to instructors
        </a>
    </div>
    <section class="panel" style="max-width:750px;margin:0 auto">
        <div class="details-body">
            <div style="display:flex;align-items:center;gap:13px;margin-bottom:20px">
                <div style="width:48px;height:48px;border-radius:15px;background:#ffeaec;color:#d74757;display:grid;place-items:center;font-size:22px">
                    !
                </div>
                <div>
                    <h3 class="panel-title" style="font-size:16px">
                        Are you sure you want to delete this instructor?
                    </h3>
                    
                </div>
            </div>
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        Instructor ID
                    </div>
                    <div class="detail-value">
                       @Model.id
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Instructor name
                    </div>
                    <div class="detail-value">
                        @Model.name
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Email
                    </div>
                    <div class="detail-value">
                        @Model.Email
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Phone
                    </div>
                    <div class="detail-value">
                        @Model.phone
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Specialization
                    </div>
                    <div class="detail-value">
                        @Model.specialization
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Bio
                    </div>
                    <div class="detail-value">
                        @Model.bio
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Image
                    </div>
                    <div class="detail-value">
                        @Model.ImagePath
                    </div>
                </div>
            </div>
            <form asp-controller="Instructor" asp-action="Delete" method="post" class="form-footer">
                <a class="btn btn-light" asp-controller="Instructor" asp-action="Index">
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger">
                    Confirm delete
                </button>
            </form>
          
        </div>
    </section>
  
</div>

</div>

