@model WebApplication1.Models.Instructor

@{
    ViewData["Title"] = "Create";
}
<div class="content" >
    <div class="page-head">
        <div>
            <h2 class="page-title">
                Add a new instructor
            </h2>
        </div>
        <a asp-controller ="Instructor" asp-action="Index" class="btn btn-light">
            ← Back to instructors
        </a>
    </div>
    <div class="form-layout">
        <section class="panel form-panel" class="panel form-panel" style="width: 100%; max-width: none; grid-column: 1 / -1; box-sizing: border-box;">
            <h3 class="form-section-title">
                Instructor information
            </h3>
            <form asp-controller="Instructor" asp-action="Create" method="post">
                <div class="field">
                    <label asp-for="name">
                        Instructor name 
                    </label>
                    <input asp-for="name" placeholder="e.g.mina ezzat"  maxlength="100">
                </div>
                <div class="two-fields">
                    <div class="field">
                        <label asp-for="Email">
                            Email 
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="instructor@example.com" />   
                    </div>
                    <div class="field">
                        <label asp-for="phone">
                            phone
                        </label>
                        <input asp-for="phone" type="tel" class="form-control" placeholder="Enter phone number" />
                    </div>
                </div>
                     <div class="two-fields">
                    <div class="field">
                        <label asp-for="specialization">
                            specialization 
                        </label>
                        <input asp-for="specialization" class="form-control" placeholder="Enter specialization" />   
                    </div>
                    <div class="field">
                        <label asp-for="bio">
                            bio
                        </label>
                        <input asp-for="bio"  class="form-control" placeholder="Enter bio" />
                    </div>
                </div>
                <div class="two-fields">
                    <div class="field">
                        <label asp-for="ImagePath">
                            Student image
                        </label>
                        <input asp-for="ImagePath" type="file" accept="image/*">
                    </div>
                    <div class="field">
                        <label asp-for="IsActive">
                            Status
                        </label>
                        <select name="IsActive" class="form-control">
                            <option value="">-- Select Status --</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="form-footer">
                    <a asp-controller="Instructor" asp-action="Index" class="btn btn-light">
                        Cancel
                    </a>
                    <button class="btn btn-primary" type="submit">
                        Save Instructor ↗
                    </button>
               </div> 
              
            </form>
        </section>
      
        
    </div>
</div>


