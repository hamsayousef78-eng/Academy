@model IEnumerable<WebApplication1.Models.Course>

@{
    ViewData["Title"] = "Index";
}
<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">
                Learner directory
            </div>
            <h2 class="page-title">
                Courses
            </h2>
           @if (TempData["Error"] != null)//عسان الرساله تظهر
            {
               <div class="alert alert-danger" role="alert">
              @TempData["Error"]
             </div>
           }
        </div>
        <a class="btn btn-primary" asp-controller="Course" asp-action="Create">
            Add course
        </a>
    </div>
    <section class="panel">
        <div class="toolbar">
            <div>
                <div class="cell-title">
                    Course directory
                </div>
            
            </div>
            <select>
                <option>
                    All Courses
                </option>
                <option>
                    Active
                </option>
            </select>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>
                            Course
                        </th>
                        <th>
                            Description
                        </th>
                        <th>
                            Category
                        </th>
                        <th>
                            DurationHours
                        </th>
                          <th>
                            Price
                        </th>
                          <th>
                            Image
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.name)
                        </td>
                        <td>
                           
                            @Html.DisplayFor(model => item.description)
                         
                        </td>
                        <td>
                        
                            @Html.DisplayFor(model => item.category)
                         
                        </td>
                         <td>
                        
                            @Html.DisplayFor(model => item.durationHours)
                         
                        </td>
                         <td>
                        
                            @Html.DisplayFor(model => item.price)
                         
                        </td>
                        <td>
                    
                            @Html.DisplayFor(model => item.ImagePath)
                           
                        </td>
                        <td>
                          @if (item.IsActive)
                         {
                       <span class="pill active-pill">Active</span>
                       }
                      else
                       {
                                <span class="pill upcoming-pill">Inactive</span>
                       }
                        </td>
                     
                        <td>
                            <a class="mini-btn"  asp-action="Edit" asp-route-id="@item.id">Edit</a> 
                            <a class="mini-btn"  asp-action="Details" asp-route-id="@item.id">Details</a>
                            <a class="mini-btn"  asp-action="Delete" asp-route-id="@item.id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
        
    </section>

