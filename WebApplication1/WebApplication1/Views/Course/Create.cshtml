@model WebApplication1.Models.Course

@{
    ViewData["Title"] = "Create";
}
<div class="content" >
    <div class="page-head">
        <div>
            <h2 class="page-title">
                Add a new course
            </h2>
        </div>
        <a asp-controller ="Course" asp-action="Index" class="btn btn-light">
            ← Back to courses
        </a>
    </div>
    <div class="form-layout">
        <section class="panel form-panel" class="panel form-panel" style="width: 100%; max-width: none; grid-column: 1 / -1; box-sizing: border-box;">
            <h3 class="form-section-title">
                Course information
            </h3>
            <form asp-controller="Course" asp-action="Create" method="post">
                <div class="field">
                    <label asp-for="name">
                        Course name 
                    </label>
                    <input asp-for="name" placeholder="e.g C++"  maxlength="100">
                </div>
                <div class="two-fields">
                    <div class="field">
                        <label asp-for="description">
                            Description 
                        </label>
                        <input asp-for="description"  class="form-control" placeholder="Enter description" />   
                    </div>
                    <div class="field">
                        <label asp-for="category">
                            Category
                        </label>
                        <input asp-for="category"  class="form-control" placeholder="Enter category" />
                    </div>
                </div>
                     <div class="two-fields">
                    <div class="field">
                        <label asp-for="durationHours">
                            Duration Hours 
                        </label>
                        <input asp-for="durationHours" class="form-control" placeholder="Enter duration hours" />   
                    </div>
                    <div class="field">
                        <label asp-for="price">
                            price
                        </label>
                        <input asp-for="price"  class="form-control" placeholder="Enter price" />
                    </div>
                </div>
                <div class="two-fields">
                    <div class="field">
                        <label asp-for="ImagePath">
                            Student image
                        </label>
                        <input asp-for="ImagePath"  accept="image/*">
                    </div>
                    <div class="field">
                        <label asp-for="IsActive">
                            Status
                        </label>
                        <select name="IsActive" class="form-control">
                            <option value="">-- Select Status --</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="form-footer">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-light">
                        Cancel
                    </a>
                    <button class="btn btn-primary" type="submit">
                        Save Course ↗
                    </button>
               </div> 
              
            </form>
        </section>
      
        
    </div>
</div>


