@model WebApplication1.Models.Course

@{
    ViewData["Title"] = "Delete";
}

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">
                Course catalog / @Model.name
            </div>
            <h2 class="page-title">
                Delete course
            </h2>
           
        </div>
        <a asp-controller="Course" asp-action="Index" class="btn btn-light">
            ← Back to courses
        </a>
    </div>
    <section class="panel" style="max-width:750px;margin:0 auto">
        <div class="details-body">
            <div style="display:flex;align-items:center;gap:13px;margin-bottom:20px">
                <div style="width:48px;height:48px;border-radius:15px;background:#ffeaec;color:#d74757;display:grid;place-items:center;font-size:22px">
                    !
                </div>
                <div>
                    <h3 class="panel-title" style="font-size:16px">
                        Are you sure you want to delete this course?
                    </h3>
                    
                </div>
            </div>
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        Course ID
                    </div>
                    <div class="detail-value">
                       @Model.id
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Course name
                    </div>
                    <div class="detail-value">
                        @Model.name
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        description
                    </div>
                    <div class="detail-value">
                        @Model.description
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        category
                    </div>
                    <div class="detail-value">
                        @Model.category
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Duration Hours
                    </div>
                    <div class="detail-value">
                        @Model.durationHours
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        price
                    </div>
                    <div class="detail-value">
                        @Model.price
                    </div>
                </div>
                 <div class="detail-item">
                 
                    <div class="detail-label">
                      Rounds
                    </div>
                    <div class="detail-value">
                        @foreach (var item in Model.courseRounds)
                        {
                            @item.name
                        }
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">
                        Image
                    </div>
                    <div class="detail-value">
                        @Model.ImagePath
                    </div>
                </div>
            </div>
            <form asp-controller="Course" asp-action="Delete" method="post" class="form-footer">
                <a class="btn btn-light" asp-controller="Course" asp-action="Index">
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger">
                    Confirm delete
                </button>
            </form>
          
        </div>
    </section>
  
</div>

</div>

