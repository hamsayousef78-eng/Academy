@model WebApplication1.Models.Enrollment

@{
    ViewData["Title"] = "Create";
}
<div class="content" >
    <div class="page-head">
        <div>
            <h2 class="page-title">
                Add a new enrollment
            </h2>
        </div>
        <a asp-controller ="Enrollment" asp-action="Index" class="btn btn-light">
            ← Back to enrollments
        </a>
    </div>
    <div class="form-layout">
        <section class="panel form-panel" class="panel form-panel" style="width: 100%; max-width: none; grid-column: 1 / -1; box-sizing: border-box;">
            <h3 class="form-section-title">
                Enrollment information
            </h3>
            <form asp-controller="Enrollment" asp-action="Create" method="post">
               
                <div class="two-fields">
                     <div class="field">
                        <label asp-for="studentId">
                           Student
                        </label>
                        <select asp-for="studentId" class="form-control">
                            <option value="">-- Select Student --</option>
                            @foreach (var student in ViewBag.student)
                            {
                                <option value="@student.id">@student.name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="courseRoundId">
                            Course Round
                        </label>
                        <select asp-for="courseRoundId" class="form-control">
                            <option value="">-- Select Course Round --</option>
                            @foreach (var enroll in ViewBag.courseRound)
                            {
                                <option value="@enroll.id">@enroll.name</option>
                            }
                        </select>
                    </div>
                </div>
                     <div class="two-fields">
              
                      
                      <div class="field">
                        <label asp-for="enrollmentDate ">
                         Enrollmen tDate  
                        </label>
                        <input asp-for="enrollmentDate " class="form-control" placeholder="" />   
                    </div>
                </div>
            
                <div class="form-footer">
                    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-light">
                        Cancel
                    </a>
                    <button class="btn btn-primary" type="submit">
                        Save Enrollment ↗
                    </button>
               </div> 
              
            </form>
        </section>
      
        
    </div>
</div>


