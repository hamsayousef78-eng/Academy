@model IEnumerable<WebApplication1.Models.Enrollment>

@{
    ViewData["Title"] = "Index";
}

<div class="content">
    <div class="page-head">
        <div>
            <div class="eyebrow">
                Learner directory
            </div>

            <h2 class="page-title">
                Enrollments
            </h2>
             @if (TempData["Error"] != null)//عسان الرساله تظهر
            {
               <div class="alert alert-danger" role="alert">
              @TempData["Error"]
             </div>
           }
        </div>
        <a class="btn btn-primary" asp-controller="Enrollment" asp-action="Create">
            Add enrollment
        </a>
    </div>
    <section class="panel">
        <div class="toolbar">
            <div>
                <div class="cell-title">
                    Instructor directory
                </div>
            
            </div>
            <select>
                <option>
                    All enrollments
                </option>
                <option>
                    Active
                </option>
            </select>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>
                            Student
                        </th>
                          <th>
                            Course
                        </th>
                        <th>
                            Round
                        </th>
                        <th>
                            Enrollment Date
                        </th>
                       
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.student.name)
                        </td>
                          <td>
                            @Html.DisplayFor(model => item.courseRound.course.name)
                        </td>
                        <td>
                           
                            @Html.DisplayFor(model => item.courseRound.name)
                         
                        </td>
                        <td>
                        
                            @Html.DisplayFor(model => item.enrollmentDate)
                         
                        </td>
                        
                      
                     
                        <td>
                            <a class="mini-btn"  asp-action="Edit" asp-route-id="@item.id">Edit</a> 
                            <a class="mini-btn"  asp-action="Details" asp-route-id="@item.id">Details</a>
                            <a class="mini-btn"  asp-action="Delete" asp-route-id="@item.id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
        
    </section>

