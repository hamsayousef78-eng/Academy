@model IEnumerable<WebApplication1.Models.Enrollment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <tr>
                <th>Stuent ID</th>
                <th>Stuent Name</th>
                <th>Course ID</th>
                <th>Course Name</th>
            </tr>
            <th></th>
        </tr>
    </thead>
    <tbody>
@if(Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.studentId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.student.name)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.courseId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.course.name)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
        else{
            <tr>
                <td>no registeration found</td>
                
            </tr>

        }
    </tbody>
</table>
